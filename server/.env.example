# Copia este fichero como ".env" (dentro de la carpeta server/) para pruebas
# LOCALES. En producción (GitHub Actions + Cloudflare Pages) estas mismas
# variables se configuran como "Secrets" / "Environment variables" en cada
# plataforma - NUNCA subas un .env real a GitHub.

# --- Base de datos ---
# Vacío = usa un fichero SQLite local en server/data/monitor.db (para probar sin
# depender de internet). Rellénalo con tus datos de Turso para producción.
TURSO_DATABASE_URL=libsql://monitor-cruces-nerobil.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODgxODc2MjEsImlkIjoiMDFhMDU4NDUtODUwMS03ZWFiLTlhYjAtODUyYjYwZDBiMThhIiwia2lkIjoiWXNqbnk5UlVMU0RnMmMtUV9lXzRsNEd2cm1MZjRGTkVqRG8yLXE2ZWZfdyIsInJpZCI6IjlmNDUxODEwLWZmZWUtNDY5Zi04MjNhLTIxZDg0NTRkYWYyYSJ9.qaI0FrSwGWRHvisFv3FzgPQNfZW2E56wQoYv0Itr7EMnmt5vr5kxJeVnLGjro2yU_358Z2BAsAz4CiAKNM9zDA

# --- Cada cuánto se revisan los mercados en modo local continuo ---
# (en GitHub Actions se deja VACÍO a propósito: el cron del workflow manda)
INTERVALO_MINUTOS=15
PAUSA_ENTRE_ACTIVOS_MS=400

# --- Canales de notificación (true/false) ---
CANAL_TELEGRAM=true
CANAL_EMAIL=false

# --- Telegram (canal principal recomendado) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email de respaldo (Yahoo Mail) ---
EMAIL_HOST=smtp.mail.yahoo.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# --- Opcional: sesión autenticada de TradingView (solo si lo necesitas) ---
TV_SESSION=
TV_SIGNATURE=

# --- Puerto del servidor local (solo para "npm start" / Render, no aplica a Cloudflare Pages) ---
PORT=3000
